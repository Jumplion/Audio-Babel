{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/warn-main-branch.sh\"",
            "timeout": 10,
            "statusMessage": "Checking current git branch..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-on-write.sh\"",
            "timeout": 60,
            "statusMessage": "Running lint/type-check..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/test-on-write.sh\"",
            "timeout": 180,
            "statusMessage": "Running tests..."
          }
        ]
      }
    ]
  }
}
