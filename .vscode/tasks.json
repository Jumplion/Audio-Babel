{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}/cpp",
        "shell": {
            "executable": "C:\\msys64\\usr\\bin\\bash.exe",
            "args": [
                "-lc"
            ]
        }
    },
    "tasks": [
        {
            "type": "shell",
            "label": "CMake: configure and build",
            "command": "mkdir -p build; cd build; cmake -G \"MinGW Makefiles\" ..; mingw32-make -j 4",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "type": "shell",
            "label": "Run tests_runner",
            "command": "cd build; ./tests_runner.exe",
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
