{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}/cpp",
        "shell": {
            "executable": "C:\\msys64\\usr\\bin\\bash.exe",
            "args": [
                "-lc"
            ]
        }
    },
    "tasks": [
        {
            "type": "shell",
            "label": "g++ (MSYS2) build",
            "command": "/mingw64/bin/g++ -std=c++17 -g -I include src/*.cpp examples/main.cpp -o examples/main.exe -lgmp -lfftw3 -lm",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}