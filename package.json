{
  "name": "audio-babel-web",
  "private": true,
  "type": "module",
  "description": "Lint/format tooling for the docs/ web frontend (JS, HTML, CSS)",
  "scripts": {
    "format": "prettier --write \"docs/**/*.{js,html,css}\"",
    "format:check": "prettier --check \"docs/**/*.{js,html,css}\"",
    "lint:js": "eslint docs/js",
    "lint:css": "stylelint \"docs/css/**/*.css\"",
    "lint:html": "htmlhint \"docs/**/*.html\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "htmlhint": "^1.1.4",
    "prettier": "^3.4.2",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1"
  }
}
