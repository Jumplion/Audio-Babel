{
    "env": {
        "browser": true,
        "node": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended",
        "eslint:recommended"
    ],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "no-unused-vars": [
            "warn",
            {
                "args": "none",
                "varsIgnorePattern": "^_"
            }
        ],
        "no-console": "off",
        "semi": [
            "error",
            "always"
        ],
        "no-empty": "off",
        "node/no-unsupported-features/es-syntax": "off"
    },
    "overrides": [
        {
            "files": [
                "../frontend/public/js/**/*.js"
            ],
            "parser": "@babel/eslint-parser",
            "env": {
                "browser": true,
                "es6": true
            },
            "parserOptions": {
                "sourceType": "module",
                "ecmaVersion": 2020,
                "requireConfigFile": false
            }
        }
    ]
}