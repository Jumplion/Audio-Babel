{
    "env": {
        "browser": true,
        "node": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:node/recommended",
        "eslint:recommended"
    ],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "no-unused-vars": [
            "warn",
            {
                "args": "none",
                "varsIgnorePattern": "^_"
            }
        ],
        "no-console": "off",
        "semi": [
            "error",
            "always"
        ]
    },
    "overrides": [
        {
            "files": [
                "../frontend/public/js/**/*.js"
            ],
            "env": {
                "browser": true,
                "es6": true
            },
            "parserOptions": {
                "sourceType": "module",
                "ecmaVersion": 2020
            }
        }
    ]
}