{
  "name": "speaker-of-babel-server",
  "version": "0.1.0",
  "description": "Minimal Node backend to accept encoded index strings and return decoded binary for reconstruction.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "lint:js": "eslint \"src/**/*.js\" --ext .js,.mjs || exit 0",
    "lint:css": "stylelint \"../frontend/public/css/**/*.css\" || exit 0",
    "lint:html": "htmlhint ../frontend/public || exit 0",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "format": "prettier --write \"../frontend/public/**/*.{html,css,js}\" src/**/*.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.4",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-node": "^11.1.0",
    "htmlhint": "^1.6.3",
    "prettier": "^2.8.8",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^32.0.0"
  }
}