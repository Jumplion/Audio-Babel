{
  "name": "speaker-of-babel-server",
  "version": "0.1.0",
  "description": "Minimal Node backend to accept encoded index strings and return decoded binary for reconstruction.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "lint:js": "eslint \"../frontend/src/**/*.js\" \"src/**/*.js\" --ext .js,.mjs || true",
    "lint:css": "stylelint \"../frontend/public/css/**/*.css\" || true",
    "lint:html": "htmlhint ../frontend/public || true",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "format": "prettier --write \"../frontend/public/**/*.{html,css,js}\" src/**/*.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-node": "^11.1.0",
    "htmlhint": "^0.14.2",
    "prettier": "^2.8.8"
  }
}
